<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_edge" android:paddingEnd="@dimen/screen_edge"
        android:paddingTop="48dp">

        <!-- Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_brand_mark" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="INACTIVE"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:letterSpacing="0.18"
                app:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/tv_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                app:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- Hero shield -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/shield_size"
            android:layout_marginBottom="12dp">

            <com.noichhar.app.ui.widget.BreathingShieldView
                android:id="@+id/shield"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="NOichhar"
            android:textColor="@color/text_white"
            android:textSize="34sp"
            android:letterSpacing="-0.02"
            app:fontFamily="@font/inter_bold" />

        <TextView
            android:id="@+id/tv_hero_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tap to activate protection"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            app:fontFamily="@font/inter_regular"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Live metrics card -->
        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEVICE-WIDE THROUGHPUT"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            android:letterSpacing="0.18"
                            app:fontFamily="@font/inter_semibold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_down" />

                            <TextView
                                android:id="@+id/tv_down_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/accent_cyan"
                                android:textSize="18sp"
                                app:fontFamily="@font/inter_bold"
                                android:layout_marginStart="4dp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_up"
                                android:layout_marginStart="18dp" />

                            <TextView
                                android:id="@+id/tv_up_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/accent_mint"
                                android:textSize="18sp"
                                app:fontFamily="@font/inter_bold"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.noichhar.app.ui.widget.WaveformMeterView
                    android:id="@+id/waveform"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <!-- Allowed / Blocked summary cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.noichhar.app.ui.widget.GlassCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_allowed_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="40sp"
                        app:fontFamily="@font/inter_bold"
                        android:letterSpacing="-0.03" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALLOWED · 7 DAYS"
                        android:textColor="@color/accent_mint"
                        android:textSize="11sp"
                        android:letterSpacing="0.2"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </com.noichhar.app.ui.widget.GlassCardView>

            <com.noichhar.app.ui.widget.GlassCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_blocked_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="40sp"
                        app:fontFamily="@font/inter_bold"
                        android:letterSpacing="-0.03" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BLOCKED · 7 DAYS"
                        android:textColor="@color/accent_coral"
                        android:textSize="11sp"
                        android:letterSpacing="0.2"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </com.noichhar.app.ui.widget.GlassCardView>
        </LinearLayout>

        <!-- Heatmap card -->
        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24-HOUR ACTIVITY"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    app:fontFamily="@font/inter_semibold" />

                <com.noichhar.app.ui.widget.ActivityHeatmapView
                    android:id="@+id/heatmap"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <!-- Primary action button -->
        <TextView
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="ACTIVATE"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:letterSpacing="0.15"
            app:fontFamily="@font/inter_bold"
            android:background="@drawable/bg_action_primary"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
