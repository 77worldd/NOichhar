<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_edge"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RULES &amp; PROTECTION"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:fontFamily="@font/inter_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Firewall Rules"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocklist Status"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold" />

                <TextView
                    android:id="@+id/tv_blocklist_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading rules…"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/btn_update_lists"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="Update Blocklists Now"
                    android:textColor="@color/text_white"
                    android:fontFamily="@font/inter_semibold"
                    android:background="@drawable/bg_action_primary"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_add_rule"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="Add Custom Rule"
                    android:textColor="@color/accent_mint"
                    android:fontFamily="@font/inter_semibold"
                    android:background="@drawable/bg_action_outline"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operation Mode"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold" />

                <RadioGroup
                    android:id="@+id/rg_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rb_dns"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="DNS filtering only"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_medium" />

                    <RadioButton
                        android:id="@+id/rb_firewall"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="App rules only"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_medium" />

                    <RadioButton
                        android:id="@+id/rb_both"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="DNS + app rules (default)"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_medium"
                        android:checked="true" />
                </RadioGroup>
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="App rules apply to DNS and supported proxy traffic; direct connections may bypass them."
            android:textSize="13sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/btn_manage_rules" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="16dp" android:gravity="center" android:text="Manage block and allow rules"
            android:textColor="@color/text_white" android:background="@drawable/bg_action_outline"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_manage_apps" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:gravity="center" android:text="Manage app rules"
            android:textColor="@color/text_white" android:background="@drawable/bg_action_outline"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_view_logs" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:gravity="center" android:text="View request logs"
            android:textColor="@color/text_white" android:background="@drawable/bg_action_outline"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
