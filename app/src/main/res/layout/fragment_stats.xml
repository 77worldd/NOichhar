<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_edge" android:paddingEnd="@dimen/screen_edge"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATISTICS"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            app:fontFamily="@font/inter_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Analytics"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:letterSpacing="-0.02"
            app:fontFamily="@font/inter_bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Time selector -->
        <com.noichhar.app.ui.widget.SegmentedTimeSelector
            android:id="@+id/time_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tv_usage_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Per-app usage requires Usage Access. Android may delay usage data."
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/btn_usage_access" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center"
            android:text="Grant Usage Access" android:textColor="@color/text_primary"
            android:background="@drawable/bg_action_outline" android:clickable="true" android:focusable="true" />

        <!-- Bandwidth totals -->
        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_unmetered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        app:fontFamily="@font/inter_bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UNMETERED"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:letterSpacing="0.18"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/glass_border"
                    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_metered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        app:fontFamily="@font/inter_bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="METERED"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:letterSpacing="0.18"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/glass_border"
                    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_overall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        app:fontFamily="@font/inter_bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OVERALL"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:letterSpacing="0.18"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <!-- Top connections -->
        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Filtered Requests by App"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:fontFamily="@font/inter_semibold" />

                    <TextView
                        android:id="@+id/btn_close_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear DNS Cache"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_semibold"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:background="@drawable/bg_action_danger"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView android:id="@+id/tv_no_requests" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="No filtered requests in this period." android:textColor="@color/text_secondary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.noichhar.app.ui.widget.RadialChartView
                        android:id="@+id/radial_chart"
                        android:layout_width="140dp"
                        android:layout_height="140dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_top_connections"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

        <!-- Most allowed apps -->
        <com.noichhar.app.ui.widget.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Bandwidth"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:fontFamily="@font/inter_semibold" />

                <TextView android:id="@+id/tv_no_bandwidth" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="No usage samples in this period." android:textColor="@color/text_secondary" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_most_allowed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.noichhar.app.ui.widget.GlassCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
