<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_edge" android:paddingEnd="@dimen/screen_edge"
        android:paddingTop="80dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOichhar"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            app:fontFamily="@font/inter_bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:fontFamily="@font/inter_medium"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Privacy-first DNS filtering. No root required. Filtering runs on-device; DNS queries use your chosen resolver and blocklists are downloaded from their publishers."
            android:textColor="@color/text_tertiary"
            app:fontFamily="@font/inter_regular"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
