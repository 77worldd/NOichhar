<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NOichhar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/button_primary_text</item>
        <item name="colorPrimaryContainer">@color/background_card</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorOnSecondary">@color/background_primary</item>
        <item name="colorSecondaryContainer">@color/background_card_elevated</item>
        <item name="colorOnSecondaryContainer">@color/text_secondary</item>
        <item name="colorTertiary">@color/accent_muted</item>
        <item name="colorOnTertiary">@color/background_primary</item>
        <item name="colorTertiaryContainer">@color/background_card</item>
        <item name="colorOnTertiaryContainer">@color/text_secondary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorSurface">@color/background_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/background_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_subtle</item>
        <item name="colorOutlineVariant">@color/border_medium</item>
        <item name="colorError">@color/status_blocked</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="colorErrorContainer">@color/background_card</item>
        <item name="colorOnErrorContainer">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NOichhar.AlertDialog</item>
        <item name="bottomNavigationStyle">@style/Widget.NOichhar.BottomNavigation</item>
        <item name="toolbarStyle">@style/Widget.NOichhar.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.NOichhar.Button</item>
        <item name="materialSwitchStyle">@style/Widget.NOichhar.Switch</item>
    </style>

    <style name="ThemeOverlay.NOichhar.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/background_card_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:backgroundDimAmount">0.38</item>
    </style>
</resources>
